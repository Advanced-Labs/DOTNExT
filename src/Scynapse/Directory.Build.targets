<Project>
  <!-- Set InformationVersion here, since $(Version) is already set at this point. -->
  <PropertyGroup>
    <InformationalVersion>$(Version). Commit Hash: $(GitHeadSha)</InformationalVersion>
  </PropertyGroup>

  <Import Condition=" '$(ScynapseBuildTimeCodeGen)' == 'true' " Project="$(MSBuildThisFileDirectory)src/Scynapse.CodeGenerator/build/Genesa.Scynapse.CodeGenerator.props" />
  <Import Condition=" '$(ScynapseBuildTimeCodeGen)' == 'true' " Project="$(MSBuildThisFileDirectory)src/Scynapse.Sdk/build/Genesa.Scynapse.Sdk.targets" />
  <ItemGroup>
    <!-- Enable code generator -->
    <ProjectReference
      Include="$(SourceRoot)src/Scynapse.CodeGenerator/Scynapse.CodeGenerator.csproj"
      OutputItemType="Analyzer"
      PrivateAssets="None"
      Condition=" '$(ScynapseBuildTimeCodeGen)' == 'true' "/>
    <ProjectReference
      Include="$(SourceRoot)src/Scynapse.Analyzers/Scynapse.Analyzers.csproj"
      AssetTargetFallback="netstandard2.0"
      UndefineProperties="TargetFramework"
      SkipGetTargetFrameworkProperties="true"
      OutputItemType="Analyzer"
      PrivateAssets="None"
      Condition=" '$(ScynapseBuildTimeCodeGen)' == 'true' "/>
  </ItemGroup>

</Project>
