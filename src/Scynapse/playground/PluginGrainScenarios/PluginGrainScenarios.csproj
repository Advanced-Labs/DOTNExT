<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>PluginGrainScenarios.Program</StartupObject>
    <!-- Required when using Scynapse via project references instead of NuGet packages.
         The source generator runs on this project and discovers all grain types from
         transitively referenced Scynapse assemblies (like Scynapse.Persistence.Memory).
         Without this, runtime assembly discovery may miss some Scynapse framework grains
         because it only follows direct (not transitive) dependencies on Scynapse.Serialization. -->
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
    <!-- Emit generated source files to disk for IDE visibility -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scynapse.Server\Scynapse.Server.csproj" />
    <ProjectReference Include="..\..\src\Scynapse.Runtime\Scynapse.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Scynapse.Streaming\Scynapse.Streaming.csproj" />
  </ItemGroup>

  <ItemGroup>
     <ProjectReference Include="..\..\src\Scynapse.CodeGenerator\Scynapse.CodeGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Make generated Scynapse files visible in IDE without re-compiling them -->
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)generated\**\*.nscynapse.g.cs"
          Link="Grains\Generated\%(Filename)%(Extension)"
          Visible="true" />
  </ItemGroup>

</Project>
