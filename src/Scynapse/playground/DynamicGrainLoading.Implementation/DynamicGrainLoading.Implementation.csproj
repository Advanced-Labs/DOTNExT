<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <!-- Required for Scynapse to generate grain activators and method invokers -->
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Scynapse.Sdk\Scynapse.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Scynapse.Runtime\Scynapse.Runtime.csproj" />
    <!-- Reference the Contracts project for interfaces -->
    <ProjectReference Include="..\DynamicGrainLoading.Contracts\DynamicGrainLoading.Contracts.csproj" />
  </ItemGroup>

</Project>
