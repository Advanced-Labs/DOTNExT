<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
    <DefineConstants>TRACE;TESTER_AZUREUTILS;SCYNAPSE_PERSISTENCE</DefineConstants>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(TestTargetFrameworks)</TargetFrameworks>
    <GenerateProgramFile>false</GenerateProgramFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Storage.Queues" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)test\TesterInternal\TesterInternal.csproj" />
    <ProjectReference Include="$(SourceRoot)\src\Azure\Scynapse.Reminders.AzureStorage\Scynapse.Reminders.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)\src\Azure\Scynapse.DurableJobs.AzureStorage\Scynapse.DurableJobs.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)\src\Azure\Scynapse.GrainDirectory.AzureStorage\Scynapse.GrainDirectory.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)\src\Azure\Scynapse.Streaming.AzureStorage\Scynapse.Streaming.AzureStorage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SourceRoot)src\Azure\Shared\Utilities\ErrorCode.cs" Link="Utilities\ErrorCode.cs" />
  </ItemGroup>
</Project>
