<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>UnitTests.SplitGrain.Contracts</RootNamespace>
    <TargetFramework>$(MinTestTargetFramework)</TargetFramework>
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Scynapse.Core.Abstractions\Scynapse.Core.Abstractions.csproj" />
    <!-- Scynapse.Runtime provides the Scynapse.Hosting and Scynapse.Runtime namespaces
         required by implicit usings injected via Genesa.Scynapse.Sdk.targets -->
    <ProjectReference Include="$(SourceRoot)src\Scynapse.Runtime\Scynapse.Runtime.csproj" />
  </ItemGroup>
</Project>
