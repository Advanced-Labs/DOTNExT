<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Genesa.Scynapse.Sdk</PackageId>
    <Description>Microsoft Scynapse meta package to bring in the base Scynapse packages for all project types.</Description>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeSymbols>false</IncludeSymbols>
    <IncludeSource>false</IncludeSource>
    <IsScynapseFrameworkPart>false</IsScynapseFrameworkPart>
    <NoWarn>MSB3277</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="buildTransitive\Genesa.Scynapse.Sdk.targets">
      <PackagePath>%(Identity)</PackagePath>
      <Visible>true</Visible>
      <Pack>true</Pack>
    </Content>
    <Content Include="build\Genesa.Scynapse.Sdk.targets">
      <Pack>true</Pack>
      <PackagePath>%(Identity)</PackagePath>
      <Visible>true</Visible>
    </Content>
    <Content Include="buildMultiTargeting\Genesa.Scynapse.Sdk.targets">
      <Pack>true</Pack>
      <PackagePath>%(Identity)</PackagePath>
      <Visible>true</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scynapse.Core\Scynapse.Core.csproj" />
    <ProjectReference Include="..\Scynapse.Analyzers\Scynapse.Analyzers.csproj" PrivateAssets="None" />
    <ProjectReference Include="..\Scynapse.CodeGenerator\Scynapse.CodeGenerator.csproj" PrivateAssets="None" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
