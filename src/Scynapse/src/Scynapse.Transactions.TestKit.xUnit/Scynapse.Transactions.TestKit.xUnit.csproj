<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Genesa.Scynapse.Transactions.TestKit.xUnit</PackageId>
    <Title>Microsoft Scynapse Transactions test kit for xUnit</Title>
    <Description>xUnit testkit library for transactions</Description>
    <PackageTags>$(PackageTags) TransactionTestKit</PackageTags>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
    <IsScynapseFrameworkPart>false</IsScynapseFrameworkPart>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Scynapse.Transactions.TestKit.xUnit</AssemblyName>
    <RootNamespace>Scynapse.Transactions.TestKit.xUnit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.extensibility.core" />
    <PackageReference Include="xunit.extensibility.execution" />
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="Xunit.SkippableFact" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scynapse.Transactions.TestKit.Base\Scynapse.Transactions.TestKit.Base.csproj" />
  </ItemGroup>

</Project>
