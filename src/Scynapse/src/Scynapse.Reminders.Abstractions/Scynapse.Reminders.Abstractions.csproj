<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Genesa.Scynapse.Reminders.Abstractions</PackageId>
    <Title>Microsoft Scynapse Reminders Abstractions</Title>
    <Description>Reminders abstractions library for Microsoft Scynapse</Description>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Scynapse</RootNamespace>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
    <DefineConstants>$(DefineConstants);SCYNAPSE_REMINDERS_PROVIDER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsOptionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsLoggingAbstractionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Scynapse.Core.Abstractions\Scynapse.Core.Abstractions.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Scynapse.Sdk\Scynapse.Sdk.csproj" />
  </ItemGroup>

</Project>
