<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Genesa.Scynapse.Persistence.Cosmos</PackageId>
    <Title>Microsoft Scynapse Grain Storage for Azure Cosmos DB</Title>
    <Description>Microsoft Scynapse persistence providers for Azure Cosmos DB</Description>
    <PackageTags>$(PackageTags) Azure Cosmos DB Storage</PackageTags>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Scynapse.Persistence.Cosmos</AssemblyName>
    <RootNamespace>Scynapse.Persistence.Cosmos</RootNamespace>
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
    <DefineConstants>$(DefineConstants);SCYNAPSE_PERSISTENCE</DefineConstants>
    <Nullable>enable</Nullable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Cosmos\CosmosOptions.cs" Link="Storage\CosmosOptions.cs" />
    <Compile Include="..\Shared\Cosmos\CosmosOptionsValidator.cs" Link="Storage\CosmosOptionsValidator.cs" />
    <Compile Include="..\Shared\Cosmos\BaseEntity.cs" Link="Storage\BaseEntity.cs" />
    <Compile Include="..\Shared\Cosmos\Usings.cs" Link="Storage\Usings.cs" />
    <Compile Include="..\Shared\Cosmos\CosmosIdSanitizer.cs" Link="Storage\CosmosIdSanitizer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Scynapse.Runtime\Scynapse.Runtime.csproj" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Tester.Cosmos</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>