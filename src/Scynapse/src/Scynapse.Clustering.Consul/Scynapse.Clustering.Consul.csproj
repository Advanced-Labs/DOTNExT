<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Genesa.Scynapse.Clustering.Consul</PackageId>
    <Title>Microsoft Scynapse clustering provider for Consul</Title>
    <Description>Microsoft Scynapse clustering provider backed by Consul</Description>
    <PackageTags>$(PackageTags) Consul</PackageTags>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AssemblyName>Scynapse.Clustering.Consul</AssemblyName>
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scynapse.Runtime\Scynapse.Runtime.csproj" />
    <PackageReference Include="Consul" />
  </ItemGroup>

</Project>
