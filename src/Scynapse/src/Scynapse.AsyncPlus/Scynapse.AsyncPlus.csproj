<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required for Scynapse code generation with project references -->
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="RavenDB.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scynapse dependencies via project references (not NuGet) -->
    <ProjectReference Include="..\Scynapse.Core.Abstractions\Scynapse.Core.Abstractions.csproj" />
    <ProjectReference Include="..\Scynapse.Core\Scynapse.Core.csproj" />
    <ProjectReference Include="..\Scynapse.Runtime\Scynapse.Runtime.csproj" />
    <ProjectReference Include="..\Scynapse.Serialization\Scynapse.Serialization.csproj" />
  </ItemGroup>

</Project>
