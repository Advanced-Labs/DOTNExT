<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>Genesa.Scynapse.Streaming.AdoNet</PackageId>
    <Title>Microsoft Scynapse ADO.NET Streaming Provider</Title>
    <Description>Microsoft Scynapse streaming provider backed by ADO.NET</Description>
    <PackageTags>$(PackageTags) ADO.NET SQL</PackageTags>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <ScynapseBuildTimeCodeGen>true</ScynapseBuildTimeCodeGen>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Scynapse.Streaming.AdoNet</AssemblyName>
    <RootNamespace>Scynapse.Streaming.AdoNet</RootNamespace>
    <DefineConstants>$(DefineConstants);STREAMING_ADONET</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tester.AdoNet" />
    <InternalsVisibleTo Include="Benchmarks.AdoNet" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Storage\*.cs" LinkBase="Storage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Scynapse.Runtime\Scynapse.Runtime.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Scynapse.Streaming\Scynapse.Streaming.csproj" />
  </ItemGroup>


  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
