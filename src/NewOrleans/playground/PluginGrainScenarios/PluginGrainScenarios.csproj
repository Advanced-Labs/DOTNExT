<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>PluginGrainScenarios.Program</StartupObject>
    <!-- Required when using Orleans via project references instead of NuGet packages.
         The source generator runs on this project and discovers all grain types from
         transitively referenced Orleans assemblies (like Orleans.Persistence.Memory).
         Without this, runtime assembly discovery may miss some Orleans framework grains
         because it only follows direct (not transitive) dependencies on Orleans.Serialization. -->
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console"  />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orleans.Server\Orleans.Server.csproj" />
    <ProjectReference Include="..\..\src\Orleans.Runtime\Orleans.Runtime.csproj" />
  </ItemGroup>

</Project>
