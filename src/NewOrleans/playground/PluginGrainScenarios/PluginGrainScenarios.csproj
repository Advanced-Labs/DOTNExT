<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>PluginGrainScenarios.Program</StartupObject>
    <!-- Required when using Orleans via project references instead of NuGet packages.
         The source generator runs on this project and discovers all grain types from
         transitively referenced Orleans assemblies (like Orleans.Persistence.Memory).
         Without this, runtime assembly discovery may miss some Orleans framework grains
         because it only follows direct (not transitive) dependencies on Orleans.Serialization. -->
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <!-- Emit generated source files to disk for IDE visibility -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Orleans.Server\Orleans.Server.csproj" />
    <ProjectReference Include="..\..\src\Orleans.Runtime\Orleans.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
     <ProjectReference Include="..\..\src\Orleans.CodeGenerator\Orleans.CodeGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Make generated Orleans files visible in IDE without re-compiling them -->
  <ItemGroup>
    <None Include="$(IntermediateOutputPath)generated\**\*.norleans.g.cs"
          Link="Grains\Generated\%(Filename)%(Extension)"
          Visible="true" />
  </ItemGroup>

</Project>
