<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>AsyncPersistenceScenarios.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!--
    Modified Roslyn Reference Options:

    OPTION A: Project Reference (requires building Roslyn solution first)
    Use this when developing/debugging the Roslyn modifications.
  -->
  <ItemGroup Condition="'$(UseRoslynProjectRef)' == 'true'">
    <ProjectReference Include="..\..\..\roslyn\src\Compilers\CSharp\Portable\Microsoft.CodeAnalysis.CSharp.csproj" />
  </ItemGroup>

  <!--
    OPTION B: DLL Reference (default - uses pre-built artifacts)
    Use this for testing after Roslyn has been built.
    TAI should run: dotnet build in roslyn folder first.
  -->
  <ItemGroup Condition="'$(UseRoslynProjectRef)' != 'true'">
    <!-- Use standard NuGet packages as fallback, with override capability -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!--
    To use the modified Roslyn DLLs instead of NuGet:
    1. Build Roslyn: cd src/roslyn && dotnet build src/Compilers/CSharp/Portable/Microsoft.CodeAnalysis.CSharp.csproj -c Release
    2. Copy artifacts to a local folder or use HintPath override

    For production testing with modified Roslyn:
    - Create a local NuGet package from the built artifacts
    - Or use assembly binding redirects
  -->

</Project>
