    {
      "type": "RouteUpgradeProbe",
      "role": "requester",
      "body": {
        "policy_allowed": true,
        "disclosure_allowed": true,
        "grant_status": "active",
        "trust_sufficient": true
      }
    },
    { "type": "RouteUpgradeReject", "role": "target", "body": { "decision_code": "UpgradeRejected" } }
  ],
  "expected_state_trace": [
    "MediatedHandshake",
    "RelayedSession",
    "DirectUpgradeProbe",
    "RelayedSession",
    "Completed"
  ],
  "expected_outcome": {
    "success": true,
    "deny_code": null,
    "upgrade_attempt_code": "UpgradeRejected"
  },
  "assertions": [
    { "id": "A1", "kind": "state", "check": "contains_state", "value": "RelayedSession" },
    { "id": "A2", "kind": "security", "check": "upgrade_decision_code_equals", "value": "UpgradeRejected" }
  ]
}
