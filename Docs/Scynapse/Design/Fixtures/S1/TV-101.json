{
  "id": "TV-101",
  "title": "Invalid Order: ResolveResponse Before ResolveRequest",
  "expect_conformance": "fail",
  "expected_error_ids": [
    "E3001_RESOLVE_MESSAGE_BEFORE_REQUEST"
  ],
  "expected_error_contains": [
    "appears before ResolveRequest"
  ],
  "preconditions": [
    "response arrives before request context exists"
  ],
  "messages": [
    { "type": "ResolveResponse", "role": "authority", "body": { "decision_code": "Resolved", "resolved_scope": ".Adult.Games.RedX" } },
    { "type": "ResolveRequest", "role": "requester", "body": { "operation_class": "meta", "expr_raw": ".Adult.Games.RedX" } }
  ],
  "expected_state_trace": [
    "Deny"
  ],
  "expected_outcome": {
    "success": false,
    "deny_code": "TrustInsufficient",
    "retryable": false
  },
  "assertions": [
    { "id": "A1", "kind": "state", "check": "final_state_equals", "value": "Deny" },
    { "id": "A2", "kind": "error", "check": "deny_code_equals", "value": "TrustInsufficient" }
  ]
}
