{
  "id": "TV-001",
  "title": "Cold Resolve Miss, Full Walk, Success",
  "preconditions": [
    "requester cache miss",
    "no direct authority hint",
    "path exists under reachable namespace"
  ],
  "messages": [
    { "type": "ResolveRequest", "role": "requester", "body": { "operation_class": "meta", "expr_raw": ".Adult.Games.RedX" } },
    { "type": "ResolveReferral", "role": "mediator" },
    { "type": "ResolveResponse", "role": "authority" }
  ],
  "expected_state_trace": [
    "ResolveIntent",
    "DiscoverPath",
    "PolicyEvaluate",
    "DisclosurePlan",
    "MediatedHandshake",
    "RelayedSession",
