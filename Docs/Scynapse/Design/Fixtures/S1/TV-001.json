  "expected_outcome": {
    "success": true,
    "deny_code": null
  },
  "assertions": [
    { "id": "A1", "kind": "state", "check": "final_state_equals", "value": "Completed" },
    { "id": "A2", "kind": "error", "check": "deny_code_absent", "value": true },
    { "id": "A3", "kind": "field", "check": "required_fields_present", "value": ["msg_type", "msg_id", "trace_id", "ttl_ms"] }
  ]
