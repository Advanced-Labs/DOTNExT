{
  "id": "TV-107",
  "title": "Ambiguous Resolve: Missing Selector Hints with Success Response",
  "expect_conformance": "fail",
  "expected_error_ids": [
    "E3017_AMBIGUOUS_SELECTOR_HINTS_REQUIRED"
  ],
  "preconditions": [
    "multiple candidates require selector hints",
    "selector hints are missing"
  ],
  "messages": [
    { "type": "ResolveRequest", "role": "requester", "body": { "operation_class": "meta", "expr_raw": ".Adult.Games.RedX", "requires_selector_hints": true } },
    { "type": "ResolveResponse", "role": "authority", "body": { "decision_code": "Resolved" } }
  ],
  "expected_state_trace": [
    "ResolveIntent",
    "DiscoverPath",
    "Deny"
  ],
  "expected_outcome": {
    "success": false,
    "deny_code": "AmbiguousResolution",
    "retryable": true
  },
  "assertions": [
    { "id": "A1", "kind": "state", "check": "final_state_equals", "value": "Deny" },
    { "id": "A2", "kind": "error", "check": "deny_code_equals", "value": "AmbiguousResolution" }
  ]
}
