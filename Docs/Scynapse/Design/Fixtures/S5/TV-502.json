  "expected_state_trace": [
    "PolicyEvaluate",
    "Deny"
  ],
  "expected_outcome": {
    "success": false,
    "deny_code": "PolicyDenied",
    "retryable": false
  },
  "assertions": [
    { "id": "A1", "kind": "state", "check": "final_state_equals", "value": "Deny" },
    { "id": "A2", "kind": "error", "check": "deny_code_equals", "value": "PolicyDenied" }
