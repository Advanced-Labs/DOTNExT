{
  "id": "TV-302",
  "title": "Invalid Endpoint Success: Active Grant Without GrantPresent Proof",
  "slice_profile": "S3",
  "expect_conformance": "fail",
  "expected_error_ids": [
    "E3036_S3_ENDPOINT_GRANT_PROOF_MISSING"
  ],
  "expected_error_contains": [
    "requires GrantPresent proof path"
  ],
  "preconditions": [
    "endpoint directory mode is encrypted",
    "grant status is active but proof path is omitted"
  ],
  "messages": [
    {
      "type": "ResolveRequest",
      "role": "requester",
      "body": {
        "operation_class": "endpoint",
        "expr_raw": ".Adult.Games.RedX.Endpoint",
        "endpoint_directory_mode": "encrypted",
        "endpoint_grant_status": "active",
        "endpoint_disclosure_allowed": true
      }
    },
    { "type": "ResolveResponse", "role": "authority" }
  ],
  "expected_state_trace": [
    "ResolveIntent",
    "DiscoverPath",
    "Deny"
  ],
  "expected_outcome": {
    "success": false,
    "deny_code": "GrantMissing",
    "retryable": true
  },
  "assertions": [
    { "id": "A1", "kind": "state", "check": "final_state_equals", "value": "Deny" },
    { "id": "A2", "kind": "error", "check": "deny_code_equals", "value": "GrantMissing" }
  ]
}
