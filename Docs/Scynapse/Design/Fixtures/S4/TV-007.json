    { "type": "ObserveEvent", "role": "authority", "body": { "event_type": "ValueChanged" } }
  ],
  "expected_state_trace": [
    "ObserveIdle",
    "ObservePendingAck",
    "ObserveActive"
  ],
  "expected_outcome": {
    "success": true,
    "deny_code": null
  },
  "assertions": [
    { "id": "A1", "kind": "state", "check": "final_state_equals", "value": "ObserveActive" },
    { "id": "A2", "kind": "error", "check": "deny_code_absent", "value": true }
  ]
