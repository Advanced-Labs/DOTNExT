{
  "id": "TV-007",
  "title": "Observe Subtree with follow_moves=true",
  "slice_profile": "S4",
  "preconditions": [
    "subscription scope is subtree",
    "follow_moves is true"
  ],
  "messages": [
    { "type": "ObserveOpen", "role": "requester", "body": { "scope_mode": "subtree", "follow_moves": true } },
