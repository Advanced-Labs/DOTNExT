    {
      "type": "HandshakeAccept",
      "role": "mediator",
      "body": {
        "route_mode": "parent_mediated",
        "disclosure_level": "mediator_visible",
        "token_transport": "reference",
        "relation_token_ref": "tid:reltok-1103",
        "relation_token_cid": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "reference_lookup_status": "resolved",
        "reference_lookup_cid": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
      }
    }
  ],
  "expected_state_trace": [
    "MediatedHandshake",
    "Deny"
  ],
  "expected_outcome": {
    "success": false,
    "deny_code": "TrustInsufficient",
    "retryable": false
  },
  "assertions": [
    { "id": "A1", "kind": "error", "check": "deny_code_equals", "value": "TrustInsufficient" }
  ]
}
