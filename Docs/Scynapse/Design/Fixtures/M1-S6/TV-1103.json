{
  "id": "TV-1103",
  "title": "M1-S6 Reference Token Lookup CID Mismatch",
  "slice_profile": "M1-S6",
  "expect_conformance": "fail",
  "expected_error_ids": [
    "E3102_M1S6_REFERENCE_TOKEN_CID_MISMATCH"
